# Database (SQLite)
DATABASE_URL=file:./db/custom.db

# Session signing secret (generate with: openssl rand -hex 32; minimum 32 chars)
SESSION_SECRET=

# M-Pesa payment adapter: "mock" (simulated STK push, great for demos/tests)
# or "daraja" (Safaricom official API - sandbox or production)
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# When set, daraja-mode callbacks must also present this secret
# (x-callback-secret header, or ?secret= in the callback URL)
MPESA_CALLBACK_SECRET=

# GPS tracking microservice
TRACKING_SERVICE_URL=http://localhost:3003
# Shared secret for the tracking service (generate: openssl rand -hex 32).
# The app uses it to call /sim/*, /trips/* and to sign per-booking socket
# join tokens. Must equal TRACKING_INTERNAL_KEY in
# mini-services/tracking-service/.env — without it those calls fail closed.
TRACKING_INTERNAL_KEY=

# Extra origins allowed to make state-changing /api requests from browsers
# (the deployment's own host is always allowed). Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000
