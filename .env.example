# Database (SQLite)
DATABASE_URL=file:./db/custom.db

# Session signing secret (generate with: openssl rand -hex 32; minimum 32 chars)
SESSION_SECRET=

# M-Pesa payment adapter: "mock" (simulated STK push, great for demos/tests)
# or "daraja" (Safaricom official API - sandbox or production)
# Any other value is rejected at runtime (fail-closed on typos).
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# REQUIRED in daraja mode (fail-closed): Safaricom callbacks must present
# this secret in the `x-callback-secret` header. Without it the callback
# endpoint refuses ALL callbacks (an open callback URL would let anyone forge
# "payment received"). Configure Safaricom's CallbackURL with a proxy that
# adds the header, or point it at a secret-bearing gateway path.
MPESA_CALLBACK_SECRET=

# Card gateway: the card flow is a SIMULATION (no real PSP). In production
# deployments it is disabled unless this is explicitly set to "true".
CARD_MOCK_ENABLED=

# Production database seeding: refuses to run without a real password
# (min 8 chars, not demo123) for every seeded account. Dev keeps demo123.
SEED_ADMIN_PASSWORD=

# GPS tracking microservice
TRACKING_SERVICE_URL=http://localhost:3003
# Shared secret for the tracking service (generate: openssl rand -hex 32).
# The app uses it to call /sim/*, /trips/* and to sign per-booking socket
# join tokens. Must equal TRACKING_INTERNAL_KEY in
# mini-services/tracking-service/.env — without it those calls fail closed.
TRACKING_INTERNAL_KEY=

# Extra origins allowed to make state-changing /api requests from browsers
# (the deployment's own host is always allowed). Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000
