<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{{APP_NAME}} — Connect</title>
<style>
  :root { --brand: {{BRAND_COLOR}}; --brand-dark: {{BRAND_COLOR_DARK}}; }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: linear-gradient(160deg, #f6f8f7 0%, #eef2f0 100%);
    min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .card {
    width: 100%; max-width: 400px; background: #fff; border-radius: 24px;
    box-shadow: 0 12px 40px rgba(0,0,0,.10); padding: 40px 28px 28px; text-align: center;
  }
  .mark {
    width: 88px; height: 88px; border-radius: 22px; background: var(--brand);
    margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 20px rgba(0,0,0,.18);
  }
  .mark svg { width: 52px; height: 52px; }
  h1 { font-size: 22px; color: #1b1f1e; margin-bottom: 6px; }
  .sub { font-size: 14px; line-height: 1.5; color: #5b6360; margin-bottom: 26px; }
  form { text-align: left; }
  label { display: block; font-size: 12px; font-weight: 700; letter-spacing: .4px;
    text-transform: uppercase; color: #6b7370; margin-bottom: 8px; }
  .row { display: flex; gap: 10px; }
  input[type=url] {
    flex: 1; min-width: 0; font-size: 16px; padding: 14px 16px; border-radius: 14px;
    border: 1.5px solid #d5dbd8; background: #fbfdfc; color: #1b1f1e; outline: none;
  }
  input[type=url]:focus { border-color: var(--brand); background: #fff; }
  button {
    font-size: 16px; font-weight: 700; color: #fff; background: var(--brand);
    border: 0; border-radius: 14px; padding: 14px 26px; cursor: pointer;
  }
  button:active { background: var(--brand-dark); }
  .hint { font-size: 12.5px; color: #7a827f; margin-top: 18px; line-height: 1.6; }
  .err { display: none; font-size: 13px; color: #be123c; background: #fdeef2;
    border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; text-align: left; }
  .foot { margin-top: 22px; font-size: 11.5px; color: #9aa19e; }
  .spinner {
    display: none; width: 18px; height: 18px; vertical-align: -4px; margin-right: 8px;
    border: 2.5px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%;
    animation: spin .7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
  <div class="card">
    <div class="mark" aria-hidden="true">
      <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
        <rect x="116" y="160" width="280" height="136" rx="46" fill="#fff"/>
        <rect x="158" y="184" width="196" height="54" rx="20" fill="{{BRAND_COLOR}}"/>
        <rect x="150" y="260" width="212" height="10" rx="5" fill="{{BRAND_COLOR}}"/>
        <rect x="100" y="306" width="64" height="46" rx="16" fill="#fff"/>
        <rect x="348" y="306" width="64" height="46" rx="16" fill="#fff"/>
      </svg>
    </div>
    <h1>{{APP_NAME}}</h1>
    <p class="sub">{{BLURB}}.<br />Connect to your SafariDrive server to continue.</p>

    <div class="err" id="err">That doesn't look like a valid address.</div>

    <form id="f" novalidate>
      <label for="server">Server address</label>
      <div class="row">
        <input id="server" type="url" inputmode="url" autocapitalize="off" spellcheck="false"
          placeholder="https://safaridrive.co.ke" autocomplete="off" />
        <button type="submit" id="go"><span class="spinner" id="sp"></span>Connect</button>
      </div>
      <p class="hint">
        Enter the web address of the SafariDrive platform (ask your operator if unsure).
        This app opens the <strong>{{ROLE_LABEL}}</strong> side automatically.
      </p>
    </form>

    <p class="foot">{{APP_NAME}} · v{{VERSION_NAME}}</p>
  </div>

<script>
  (function () {
    var ROLE = '{{ROLE_ID}}'; // customer | owner | driver | admin
    var LAST = 'sd_last_server';

    function el(id) { return document.getElementById(id); }

    // ?clear=1 -> forget the saved server and show the form
    if (location.search.indexOf('clear=1') !== -1) {
      try { localStorage.removeItem('sd_server'); } catch (e) {}
    }

    // Auto-connect when a server was saved on a previous launch
    try {
      var saved = localStorage.getItem('sd_server');
      if (saved && location.search.indexOf('clear=1') === -1) { go(saved, true); return; }
    } catch (e) { /* storage unavailable: fall through to the form */ }

    function normalize(raw) {
      var v = (raw || '').trim().replace(/\/+$/, '');
      if (!v) return '';
      if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
      try { var u = new URL(v); if (!u.hostname || /\s/.test(v)) return ''; } catch (e) { return ''; }
      return v;
    }

    function go(server, instant) {
      try { localStorage.setItem('sd_server', server); localStorage.setItem(LAST, server); } catch (e) {}
      var target = server + '/?app=' + ROLE;
      if (instant) { location.replace(target); }
      else {
        el('sp').style.display = 'inline-block';
        setTimeout(function () { location.replace(target); }, 350);
      }
    }

    el('f').addEventListener('submit', function (ev) {
      ev.preventDefault();
      var v = normalize(el('server').value);
      if (!v) { el('err').style.display = 'block'; el('server').focus(); return; }
      el('err').style.display = 'none';
      go(v, false);
    });

    el('server').addEventListener('input', function () { el('err').style.display = 'none'; });
  })();
</script>
</body>
</html>
