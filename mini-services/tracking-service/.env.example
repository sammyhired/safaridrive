# Shared secret between the Next.js backend and this service.
# Generate with: openssl rand -hex 32
# Must match TRACKING_INTERNAL_KEY in the main app's .env.
TRACKING_INTERNAL_KEY=replace-with-openssl-rand-hex-32

# Bind address. Default 127.0.0.1 — only the gateway (Caddy) and the Next.js
# backend (server-to-server on localhost) need to reach this service. Set to
# 0.0.0.0 ONLY if the service runs on a dedicated host behind a firewall.
#BIND_HOST=127.0.0.1

# Only needed for split deployments where browsers hit a DIFFERENT origin than
# this service directly (not through the same-origin gateway). Comma-separated
# list of allowed browser origins, e.g. https://safaridrive.co.ke. Leave unset
# for the standard same-origin gateway setup (no cross-origin access at all).
#TRACKING_ALLOWED_ORIGINS=https://safaridrive.co.ke

# --- GPS tracker provisioning -----------------------------------------------
# Real trackers must send their per-device key alongside their vehicleId:
#   key = HMAC-SHA256(TRACKING_INTERNAL_KEY, "device:" + vehicleId)  (hex)
# Example GET (OSMAND protocol):
#   GET /?id=<vehicleId>&key=<deviceKey>&lat=-1.29&lon=36.78&speed=42&heading=90
# Derive a device key without openssl scripting: run the service's helper —
#   node -e "require('node:crypto')" … or from the app host:
#   bun -e "console.log(require('node:crypto').createHmac('sha256', process.env.TRACKING_INTERNAL_KEY).update('device:<vehicleId>').digest('hex'))"
